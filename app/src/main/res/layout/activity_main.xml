<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:background="@color/background_light">

    <!-- Título principal -->
    <TextView
        android:id="@+id/tvBienvenido"
        android:layout_width="0dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/primary_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tu bóveda segura para gestionar credenciales y cuentas digitales en un solo lugar"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvBienvenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Comenzar (visible al inicio) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnComenzar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Comenzar"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="28dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescripcion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Ver Cuentas (se muestra después de registro) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerCuentas"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Ver Cuentas"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="28dp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnComenzar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Administrar (se muestra después de registro) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdministrar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Administrar"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/orange"
        app:cornerRadius="28dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnVerCuentas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>