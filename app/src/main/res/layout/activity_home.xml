<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/soft_red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Contenedor para contenido según rol -->
    <LinearLayout
        android:id="@+id/llUserContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvRole"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Aparecerá para usuarios normales -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewCuentasNormal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver Cuentas"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp" />

        <!-- Aparecerá solo para admin -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Agregar Cuenta"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewTodasCuentas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver Todas las Cuentas"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp"
            app:backgroundTint="@color/blue_accent"
            app:cornerRadius="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageUsers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Gestionar Usuarios"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:backgroundTint="@color/orange"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Botón Volver / Cerrar Sesión – al fondo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="24dp"
        android:text="Volver"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>